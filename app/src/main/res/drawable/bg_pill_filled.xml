<?xml version="1.0" encoding="utf-8"?>
<!-- A word to act on, drawn as a filled pill: the tint band's own blue cut to the same round
     as the outlined pills beside it, with a tap answered in the same shape. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3cffffff">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3949ab" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="50dp" />
        </shape>
    </item>
</ripple>
