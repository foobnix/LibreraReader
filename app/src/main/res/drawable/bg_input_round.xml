<?xml version="1.0" encoding="utf-8"?>
<!-- A field to type into: a rounded well cut to the card's own round, ringed thinly so it
     reads as an input without the heavy border slab it used to carry. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true"><shape android:shape="rectangle">
            <solid android:color="#25ffffff" />
            <stroke android:width="1dp" android:color="#5C6BC0" />
            <corners android:radius="@dimen/radius" />
        </shape></item>
    <item><shape android:shape="rectangle">
            <solid android:color="#20ffffff" />
            <stroke android:width="1dp" android:color="#66ffffff" />
            <corners android:radius="@dimen/radius" />
        </shape></item>

</selector>
