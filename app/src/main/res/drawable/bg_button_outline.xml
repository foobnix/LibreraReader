<?xml version="1.0" encoding="utf-8"?>
<!-- A link in the settings panel, drawn as a button: a ring around the word cut to the same
     round the cards are, with nothing filled in behind it so the panel carries through, and a
     tap answered in the same shape. The ring is recoloured to the theme when it is bound. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3c888888">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <stroke android:width="1dp" android:color="@color/tint_gray" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
</ripple>
