<?xml version="1.0" encoding="utf-8"?>
<!-- An outlined button: a ring around the word or the mark, cut to the same round the rest of
     the chrome is drawn in. The ring is the colour of what it holds - the styles that use this
     tint their mark with the same link colour - rather than a grey line of its own that reads
     as unrelated to the icon inside it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <stroke android:width="1dip" android:color="?android:attr/textColorLink" />
            <solid android:color="@color/tint_divider"/>
            <corners android:radius="@dimen/radius" />
        </shape></item>
    <item>
        <shape>
            <stroke android:width="1dip" android:color="?android:attr/textColorLink" />
            <solid android:color="@color/transparent"/>
            <corners android:radius="@dimen/radius" />
        </shape></item>

</selector>
