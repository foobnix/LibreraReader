<?xml version="1.0" encoding="utf-8"?>
<!--
    The notice a clear install opens on: there are no books yet and two ways to bring some in.
    Either the app is allowed to go looking for them itself, or the user hands over one folder
    through the system's picker. Shared by the library and the folders screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOnGrant"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/green_msg"
    android:orientation="vertical"
    android:paddingTop="4dip"
    android:paddingBottom="4dip">

    <LinearLayout
        android:id="@+id/onGrantPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dip"
        android:paddingBottom="4dip">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"
            android:layout_weight="1"
            android:text="@string/add_all_books_with_permission"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/onGrantPermissionButton"
            style="@style/textLinkWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"
            android:layout_marginRight="6dip"
            android:layout_weight="0"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:paddingLeft="16dip"
            android:paddingTop="5dip"
            android:paddingRight="16dip"
            android:paddingBottom="5dip"
            android:text="@string/allow"
            android:textAllCaps="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dip"
        android:layout_marginLeft="5dip"
        android:layout_marginRight="6dip"
        android:alpha="0.25"
        android:background="@color/white" />

    <LinearLayout
        android:id="@+id/onGrantChooseFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dip"
        android:paddingBottom="4dip">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"
            android:layout_weight="1"
            android:text="@string/add_folder_with_books"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/onGrantChooseFolderButton"
            style="@style/textLinkWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"
            android:layout_marginRight="6dip"
            android:layout_weight="0"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:paddingLeft="16dip"
            android:paddingTop="5dip"
            android:paddingRight="16dip"
            android:paddingBottom="5dip"
            android:text="@string/choose_"
            android:textAllCaps="true" />
    </LinearLayout>

</LinearLayout>
