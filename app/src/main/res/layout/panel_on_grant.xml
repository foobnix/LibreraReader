<?xml version="1.0" encoding="utf-8"?>
<!--
    The notice a clear install opens on: there are no books yet, and the app asks for the
    permission to go looking for them. Once the user has handed over a folder of books through
    the system's picker instead (+ Storage), that offer goes and the notice asks for the Librera
    folder, to keep the settings and reading progress in. Shared by the library and the folders
    screen.

    The notices about the LibreraX migration and the permission take the full width, with their
    button centred under the words; they are single rows of the table, outside its columns.

    In a table row, the words column both stretches and shrinks. Stretching alone pushes the button off the
    edge of the screen the moment a sentence is long enough - which it is in most languages -
    and a button that cannot be seen cannot be pressed. Shrinking lets the sentence wrap onto
    a second line instead, and the button keeps the width it needs.
-->
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOnGrant"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/green_msg"
    android:paddingTop="4dip"
    android:paddingBottom="4dip"
    android:shrinkColumns="0"
    android:stretchColumns="0">

    <!-- In the apps being retired: get LibreraX, or, once installed, export to it; see LibreraX.migrate. -->
    <LinearLayout
        android:id="@+id/onGrantMigrate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dip"
        android:paddingBottom="4dip">

        <TextView
            android:id="@+id/onGrantMigrateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"
            android:layout_marginRight="6dip"
            android:text="@string/librerax_migrate"
            android:textColor="@color/white" />

        <!-- A frame, so the button stands in the middle whatever the cross beside it takes up. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dip">

            <ImageView
                android:id="@+id/onGrantMigrateClose"
                android:layout_width="32dip"
                android:layout_height="32dip"
                android:layout_gravity="right|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="6dip"
                android:src="@drawable/glyphicons_599_menu_close"
                android:tag="@string/no_tint"
                android:tint="@color/white" />

            <LinearLayout
                android:id="@+id/onGrantMigrateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="5dip"
                android:paddingTop="4dip"
                android:paddingRight="12dip"
                android:paddingBottom="4dip">

                <ImageView
                    android:id="@+id/onGrantMigrateIcon"
                    android:layout_width="24dip"
                    android:layout_height="24dip"
                    android:contentDescription="@string/librerax"
                    android:src="@drawable/icon_librerax"
                    android:tag="@string/no_tint" />

                <TextView
                    android:id="@+id/onGrantMigrateButtonText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dip"
                    android:text="@string/librerax"
                    android:textColor="@color/white" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/onGrantPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="4dip"
        android:paddingBottom="4dip">

        <!-- Each page says what the permission would give it; see UIFragment.permissionMessage. -->
        <TextView
            android:id="@+id/onGrantPermissionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"
            android:layout_marginRight="6dip"
            android:text="@string/add_all_books_with_permission"
            android:textColor="@color/white" />

        <!-- The button: a check, then the word, inside the ring. -->
        <LinearLayout
            android:id="@+id/onGrantPermissionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dip"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dip"
            android:paddingTop="5dip"
            android:paddingRight="16dip"
            android:paddingBottom="5dip">

            <ImageView
                android:layout_width="16dip"
                android:layout_height="16dip"
                android:layout_marginRight="6dip"
                android:importantForAccessibility="no"
                android:src="@drawable/glyphicons_239_check"
                android:tag="@string/no_tint"
                android:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/allow"
                android:textAllCaps="true"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Without the permission, once books come from a folder handed over in the picker: the
         settings and reading progress are kept in the Librera folder too, once it is handed
         over the same way - and straight away after a reinstall, to have back the settings an earlier
         install kept in Download/Librera. It stays until it is. -->
    <TableRow
        android:id="@+id/onGrantLibrera"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingTop="4dip"
        android:paddingBottom="4dip">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dip"
            android:text="@string/save_settings_in_librera_folder"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/onGrantLibreraButton"
            style="@style/textLinkWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dip"
            android:layout_marginRight="6dip"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:paddingLeft="16dip"
            android:paddingTop="5dip"
            android:paddingRight="16dip"
            android:paddingBottom="5dip"
            android:text="@string/choose_"
            android:textAllCaps="true" />
    </TableRow>

</TableLayout>
