<?xml version="1.0" encoding="utf-8"?>
<!-- One library folder: its mark in a round, the folder's name over where it is, and a button to
     drop it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingLeft="24dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="8dp">

    <!-- The round is filled with a wash of the theme colour by the dialog. -->
    <FrameLayout
        android:id="@+id/folderMark"
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageView
            android:id="@+id/folderIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lf_folder" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/folderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/folderPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- Shown for a folder handed over through the picker whose access is gone. -->
        <TextView
            android:id="@+id/folderNoAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/folder_no_access"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/folderRemove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="13dp"
        android:src="@drawable/ic_lf_remove" />

</LinearLayout>
