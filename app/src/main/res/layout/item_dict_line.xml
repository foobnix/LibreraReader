<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="42dip"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dip" >

    <ImageView
        android:id="@+id/image1"
        android:layout_width="40dip"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dip"
        android:layout_marginRight="8dip"
        android:src="@drawable/glyphicons_37_file" />

    <TextView
        android:visibility="gone"
        android:id="@+id/profileLetter"
        style="@style/textCircle"
        android:layout_width="32dip"
        android:layout_height="32dip"
         />

    <CheckBox
        android:visibility="gone"
        android:id="@+id/checkbox1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dip"
        android:minWidth="80dip"
        android:singleLine="true"
        android:text="Item"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="80dip"
        android:layout_marginLeft="4dip"
        android:singleLine="true"
        android:text="Item"
        android:textSize="20sp" />

    <!-- Choices made on the row itself, wrapped onto more lines when they do not fit -->
    <com.foobnix.pdf.info.view.ChoiceFlowLayout
        android:id="@+id/choices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dip"
        android:layout_marginRight="4dip"
        android:visibility="gone" />

    <!-- A row holding a view of its own, such as a slider for a value -->
    <FrameLayout
        android:id="@+id/rowExtra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- A mark on the row, not an icon naming it: it follows the name instead of standing
         in the icon column in front of it. -->
    <ImageView
        android:id="@+id/imageEnd"
        android:layout_width="20dip"
        android:layout_height="20dip"
        android:layout_marginLeft="8dip"
        android:visibility="gone" />

    <TextView
        android:id="@+id/type1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dip"
        android:text="type"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>