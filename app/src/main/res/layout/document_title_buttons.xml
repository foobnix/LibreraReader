<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="#0000ff"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="@dimen/wh_button_big"
            android:layout_marginRight="@dimen/wh_button_big"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="2dip"
            android:paddingRight="2dip"
            android:paddingTop="14dip"
            android:paddingBottom="6dip"
            >

            <ImageView
                android:id="@+id/goToPage1"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="Go to fist page"
                android:src="@drawable/glyphicons_172_skip_to_start" />

            <ImageView
                android:id="@+id/moveLeft"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="move left"
                android:src="@drawable/glyphicons_309_square_empty_left" />

            <ImageView
                android:id="@+id/moveCenter"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="align document"
                android:src="@drawable/glyphicons_112_paragraph_center" />

            <ImageView
                android:id="@+id/moveRight"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="move right"
                android:src="@drawable/glyphicons_310_square_empty_right" />

            <ImageView
                android:id="@+id/zoomMinus"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="@string/zoom_in_zoom_out"
                android:src="@drawable/glyphicons_632_circle_minus" />

            <ImageView
                android:id="@+id/zoomPlus"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="@string/zoom_in_zoom_out"
                android:src="@drawable/glyphicons_631_circle_plus" />

            <com.foobnix.pdf.info.view.UnderlineImageView
                android:id="@+id/onBC"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="@string/contrast"
                android:src="@drawable/glyphicons_92_contrast" />

            <ImageView
                android:id="@+id/brightness"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="@string/day"
                android:src="@drawable/glyphicons_232_sun" />

            <com.foobnix.pdf.info.view.UnderlineImageView
                android:id="@+id/crop"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:src="@drawable/glyphicons_94_crop" />

            <com.foobnix.pdf.info.view.UnderlineImageView
                android:id="@+id/cut"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="cut pages into two"
                android:src="@drawable/my_glyphicons_page_split"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/fullscreen"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="@string/full_screen"
                android:src="@drawable/glyphicons_216_fullscreen" />

            <ImageView
                android:id="@+id/onTextReplacement"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="@string/full_screen"
                android:src="@drawable/my_glyphicons_pen" />

            <ImageView
                android:id="@+id/prefTop"
                style="@style/buttonWhite"
                android:layout_width="@dimen/wh_button"
                android:layout_height="@dimen/wh_button"
                android:layout_weight="0"
                android:contentDescription="@string/preferences"
                android:src="@drawable/glyphicons_137_cogwheel" />
        </LinearLayout>

        <!-- The way back to the library, set in the corner opposite the one that closes the
             book and ringed the same way, so the two read as a pair. -->
        <ImageView
            android:id="@+id/onLibrary"
            style="@style/buttonWhiteClose"
            android:background="@drawable/bg_round_button"
            android:padding="7dip"
            android:layout_width="@dimen/wh_button"
            android:layout_height="@dimen/wh_button"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_gravity="left"
            android:layout_marginLeft="2dip"
            android:layout_weight="0"
            android:contentDescription="@string/library"
            android:src="@drawable/glyphicons_589_book_open" />

        <ImageView
            android:id="@+id/close"
            style="@style/buttonWhiteClose"
            android:background="@drawable/bg_round_button"
            android:padding="7dip"
            android:layout_width="@dimen/wh_button"
            android:layout_height="@dimen/wh_button"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_gravity="right"
            android:layout_marginRight="2dip"
            android:layout_weight="0"
            android:contentDescription="@string/close"
            android:src="@drawable/glyphicons_599_menu_close" />

    </RelativeLayout>

    <!-- The offer to trade a short video for time without ads: what is on offer on the left,
         and the thing to press on the right, ringed so it reads as a button rather than as
         more of the sentence. The row as a whole is still the clickable target. -->
    <LinearLayout
        android:id="@+id/showRewardVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_clickable_white"
        android:gravity="center_vertical"
        android:layout_margin="1dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <!-- The mark for the offer, cut to the height of the two lines it stands beside;
             ViewBinder sets that height from the line the message is actually drawn at. -->
        <ImageView
            android:id="@+id/showRewardVideoIcon"
            android:layout_width="wrap_content"
            android:layout_height="20dip"
            android:layout_marginLeft="6dip"
            android:layout_marginRight="4dip"
            android:layout_weight="0"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/glyphicons_smileys_13_smiling_heart_eyes"
            android:tag="no_tint"
            android:tint="@color/white_alpha_dd" />

        <TextView
            android:id="@+id/showRewardVideoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:lines="2"
            android:text="@string/watch_this_short_video_to_turn_off_all_ads_for_2_hour"
            android:textColor="@color/white_alpha_dd" />

        <TextView
            android:id="@+id/showRewardVideoButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dip"
            android:layout_marginRight="6dip"
            android:layout_weight="0"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:paddingLeft="16dip"
            android:paddingRight="16dip"
            android:paddingTop="5dip"
            android:paddingBottom="5dip"
            android:text="@string/watch"
            android:textAllCaps="true"
            android:textColor="@color/white_alpha_dd" />
    </LinearLayout>


    <include
        android:id="@+id/showHypenLangPanel"
        layout="@layout/layout_hypen_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="visible" />

    <TextView
        android:background="#F44336"
        android:visibility="gone"
        android:id="@+id/onSaveAnnotation"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center"
        android:singleLine="true"
        android:layout_weight="0"
        android:textColor="@color/white"
        android:text="@string/warning_this_document_has_unsaved_changes" />


</LinearLayout>