<?xml version="1.0" encoding="utf-8"?>
<!-- The drawing panel: what the pen draws and how thick, with the eraser for an annotation
     picked out on the page, then its colour. DragingDialogs.dialogEditColors fills it in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dip">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/drawFree"
            style="@style/drawTool"
            android:contentDescription="@string/draw_freehand"
            android:src="@drawable/draw_free" />

        <ImageView
            android:id="@+id/drawLine"
            style="@style/drawTool"
            android:contentDescription="@string/draw_line"
            android:src="@drawable/draw_line" />

        <ImageView
            android:id="@+id/drawArrow"
            style="@style/drawTool"
            android:contentDescription="@string/draw_arrow"
            android:src="@drawable/draw_arrow" />

        <ImageView
            android:id="@+id/drawRect"
            style="@style/drawTool"
            android:contentDescription="@string/draw_rectangle"
            android:src="@drawable/draw_rect" />

        <ImageView
            android:id="@+id/drawStar"
            style="@style/drawTool"
            android:contentDescription="@string/draw_star"
            android:src="@drawable/draw_star" />

        <View
            android:layout_width="1dip"
            android:layout_height="26dip"
            android:layout_marginLeft="4dip"
            android:layout_marginRight="4dip"
            android:background="@color/lt_grey_alpha" />

        <!-- How thick the pen draws, shown as a line that thick; a tap offers the others. -->
        <FrameLayout
            android:id="@+id/drawWidth"
            android:contentDescription="@string/draw_line_width"
            android:layout_width="40dip"
            android:layout_height="40dip">

            <View
                android:id="@+id/drawWidthLine"
                android:layout_width="24dip"
                android:layout_height="4dip"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Beside the width, only while an annotation on the page is picked out: a tap on one picks it out. -->
        <ImageView
            android:id="@+id/drawDelete"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:layout_marginLeft="4dip"
            android:contentDescription="@string/delete"
            android:padding="6dip"
            android:src="@drawable/glyphicons_17_bin"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawColors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dip"
        android:gravity="center_vertical"
        android:orientation="horizontal">
    </LinearLayout>

</LinearLayout>
