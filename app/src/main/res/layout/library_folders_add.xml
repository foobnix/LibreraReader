<?xml version="1.0" encoding="utf-8"?>
<!-- The two ways a folder gets into the library, side by side as ringed buttons: one the app goes
     looking in, one the system's picker hands over. Shared by the library folders dialog and the
     preferences panel, which each set the margins round it; the ring, the mark and the words are
     coloured by PrefDialogs.tintAddCards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/addLibraryFolder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_button_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/addLibraryFolderIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lf_folder_add" />

        <TextView
            android:id="@+id/addLibraryFolderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/add_folder"
            android:textColor="?android:attr/textColorLink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/addLibraryStorage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_button_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/addLibraryStorageIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lf_storage_add" />

        <TextView
            android:id="@+id/addLibraryStorageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/add_resource"
            android:textColor="?android:attr/textColorLink" />
    </LinearLayout>
</LinearLayout>
